# =====================================================
#  Garnier PulseWork · Backend · Variables de entorno
#  Copia este archivo a `.env` y completa los valores
# =====================================================

# ---------- App ----------
NODE_ENV=development
PORT=3000
BACKEND_BASE_URL=http://localhost:3000

# ---------- IA (Gemini · Google AI Studio) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------- Microsoft 365 (lectura de respuestas de Forms) ----------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_DRIVE_ITEM_ID=          # Excel vinculado al formulario

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=pulsework_user
DB_PASSWORD=
DB_NAME=garnier_pulsework

# ---------- JWT ----------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------- n8n callback (ingesta autenticada) ----------
N8N_INGEST_TOKEN=

# ---------- Reglas de negocio (configurables) ----------
MIN_RESPONSES_PER_DEPT=5          # umbral de anonimato
THRESHOLD_NEGATIVE_MAX=40         # 0..N -> negativa
THRESHOLD_POSITIVE_MIN=61         # N..100 -> positiva
ALERT_RED_PCT=75                  # % negativo para rojo en semáforo

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173
